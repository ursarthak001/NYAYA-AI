# BharatCode Sovereign API Configuration
# Obtain your API key from https://bharatcode.ai
BHARATCODE_API_KEY=your_new_secure_api_key_here

# Upstash Redis Rate Limiting Configuration (5 requests/hour/IP)
# Configured via Upstash Console: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
